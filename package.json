{
  "name": "sublink-worker",
  "version": "2.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:css && node scripts/build-vercel.mjs",
    "build:css": "tailwindcss -i src/styles/app.css -o public/styles.css --minify",
    "build:node": "npm run build:css && node_modules/.bin/esbuild src/platforms/node-server.js --bundle --platform=node --target=node18 --format=cjs --outfile=dist/node-server.cjs",
    "deploy": "npm run setup-kv && npm run build:css && wrangler deploy",
    "dev": "npm run build:css && wrangler dev",
    "dev:css": "tailwindcss -i src/styles/app.css -o public/styles.css --watch",
    "dev:node": "npm run build:node && node dist/node-server.cjs",
    "setup-kv": "node scripts/setup-kv.cjs",
    "start": "npm run build:css && wrangler dev",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.16.8",
    "esbuild": "^0.27.0",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.14",
    "vitest": "4.1.7",
    "wrangler": "^4.51.0"
  },
  "dependencies": {
    "esbuild-register": "^3.6.0",
    "hono": "^4.10.7",
    "ioredis": "^5.8.2",
    "js-yaml": "^4.1.1"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.11.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@cloudflare/workerd-windows-64",
      "@cloudflare/workerd-linux-64",
      "@cloudflare/workerd-darwin-64",
      "@cloudflare/workerd-darwin-arm64",
      "@cloudflare/workerd-linux-arm64",
      "workerd",
      "esbuild"
    ]
  }
}
